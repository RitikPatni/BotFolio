---
import BaseLayout from '../../layouts/BaseLayout/BaseLayout.astro';
import { USES_SECTIONS } from '../../data/uses';
import './_uses.scss';
---

<BaseLayout title="Uses — Ritik Patni" path="/uses">
  <div class="uses-v2">
    <h1 class="uses-title">Uses</h1>
    <p class="uses-lead">Hardware, software, and tools I use for development and photography.</p>

    <div class="uses-body">
      {USES_SECTIONS.map((section) => (
        <section class="uses-section">
          <h2 class="uses-section-title">{section.label}</h2>
          <ul class="uses-list">
            {section.cards.flatMap((card) =>
              card.items.map((item) => (
                <li class="uses-item">
                  {item.label && <span class="uses-item-label">{item.label}</span>}
                  {item.text}
                </li>
              ))
            )}
          </ul>
        </section>
      ))}
    </div>

    <p class="uses-footnote">This page evolves as my setup changes.</p>
  </div>
</BaseLayout>
