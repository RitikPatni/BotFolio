---
import BaseLayout from "../layouts/BaseLayout/BaseLayout.astro";
import "./_404.scss";
---

<BaseLayout
  title="Page not found — Ritik Patni"
  description="This page doesn't exist. Head back to the notes, the gallery or the home page."
  path="/404"
  noindex
>
  <div class="not-found">
    <section class="not-found__hero page-hero page-hero--standard">
      <div class="page-hero__inner">
        <p class="not-found__kicker">404 · page not found</p>
        <h1 class="not-found__title page-hero__title">Page not found</h1>
        <p class="not-found__lead page-hero__lead">
          Nothing lives at this address. It may have moved, or the link had a
          typo.
        </p>
      </div>
    </section>

    <nav class="not-found__links" aria-label="Places to go instead">
      <a class="not-found__link" href="/">
        <span class="not-found__link-title">Home</span>
        <span class="not-found__link-meta">Start over</span>
      </a>
      <a class="not-found__link" href="/blog">
        <span class="not-found__link-title">Notes</span>
        <span class="not-found__link-meta">Posts and newsletter</span>
      </a>
      <a class="not-found__link" href="/photography">
        <span class="not-found__link-title">Gallery</span>
        <span class="not-found__link-meta">Wildlife photography</span>
      </a>
    </nav>
  </div>
</BaseLayout>
