---
import { Image as AstroImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout/BaseLayout.astro";
import ExposureLine from "../../components/ExposureLine.astro";
import { getCollection } from "astro:content";
import { dateTimestamp, formatDisplayDate } from "../../utils/date";
import { photographyGalleryData } from "../../data/photography";
import { photographyCategories } from "../../data/photography/manifest";
import PhotographyLightbox from "../photography/_PhotographyLightbox.astro";
import {
  exposureOf,
  frameSlug,
  toLightboxItem,
} from "../../utils/photography/photographyLightbox.items";
import { slugOf } from "../../utils/slug";
import "./_home.scss";

const STRIP_FRAMES = 8;
const STRIP_H = { desktop: 208, mobile: 176 }; // px; mirrors --strip-h in _home.scss

const galleryAssetModules = import.meta.glob(
  "../../assets/photography/**/*.{avif,gif,jpeg,jpg,png,webp}",
  { eager: true },
) as Record<string, { default: ImageMetadata }>;

const galleryAssets = new Map(
  Object.entries(galleryAssetModules).map(([path, module]) => [
    path.replace("../../assets/photography/", ""),
    module.default,
  ]),
);

/* Build-time archive counts: each is the number of entries the linked page
   lists, so the hero can never disagree with the page it opens. */
const notes = [
  ...(await getCollection("blog", ({ data }) => !data.draft)),
  ...(await getCollection("newsletter", ({ data }) => !data.draft)),
];
const books = await getCollection("books", ({ data }) => !data.draft);
const frameCount = photographyGalleryData.length;

/* Contact strip: the STRIP_FRAMES strongest frames — editorial rating first
   (blind-audit medians), most recent within a rating tier. A "recent only"
   strip would surface the newest cull regardless of strength. */
const stripFrames = photographyGalleryData
  .map((frame, order) => ({ frame, order }))
  .sort(
    (a, b) =>
      (b.frame.rating ?? 0) - (a.frame.rating ?? 0) ||
      (b.frame.date ? dateTimestamp(b.frame.date) : 0) -
        (a.frame.date ? dateTimestamp(a.frame.date) : 0) ||
      a.order - b.order,
  )
  .slice(0, STRIP_FRAMES)
  .map(({ frame }, index) => {
    const asset = galleryAssets.get(`${frame.category}/${frame.filename}`);
    if (!asset) {
      throw new Error(`Missing photography asset: ${frame.category}/${frame.filename}`);
    }
    const ratio = asset.width / asset.height;
    return {
      frame,
      asset,
      index,
      title: frame.title,
      alt: frame.alt,
      exposure: exposureOf(frame.metadata),
      sizes: `(max-width: 48rem) ${Math.ceil(ratio * STRIP_H.mobile)}px, ${Math.ceil(ratio * STRIP_H.desktop)}px`,
      /* A plain click opens the viewer here on home (see the lightbox below);
         the href is the fallback for new tabs and no-JS, and lands on the same
         frame in the gallery. */
      href: `/photography#${frameSlug(frame)}`,
    };
  });

/* The home viewer pages through the strip's own frames, in strip order, so a
   click on a frame never takes the visitor to /photography. */
const categoryLabels = new Map(photographyCategories.map((c) => [c.id, c.label]));
const stripLightboxItemsJson = JSON.stringify(
  await Promise.all(
    stripFrames.map(({ frame, asset, index }) =>
      toLightboxItem(frame, categoryLabels.get(frame.category) ?? frame.category, asset, index),
    ),
  ),
);

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => dateTimestamp(b.data.date) - dateTimestamp(a.data.date))
  .slice(0, 3)
  .map((post) => ({
    slug: slugOf(post),
    title: post.data.title,
    description: post.data.description,
    date: post.data.date,
  }));
---

<BaseLayout
  title="Ritik Patni, frontend developer and wildlife photographer"
  description="I build thoughtful web experiences and document nature up close."
  path="/"
>
  <section class="index-hero" aria-labelledby="index-statement">
    <div class="index-hero__head">
      <h1 class="index-hero__statement" id="index-statement">
        <span class="index-hero__name">Ritik Patni</span> builds thoughtful product surfaces{" "}
        <span class="index-hero__field">and documents nature up close, one frame at a time.</span>
      </h1>
    </div>

    <nav class="index-hero__ledger" aria-label="Archive">
      <a href="/blog">Notes <span class="index-hero__count" data-count="notes">{notes.length} posts</span></a>
      <a href="/photography">Gallery <span class="index-hero__count" data-count="frames">{frameCount} frames</span></a>
      <a href="/library">Library <span class="index-hero__count" data-count="books">{books.length} books</span></a>
      <a href="/about">About <span class="index-hero__count" aria-hidden="true">→</span></a>
    </nav>

    <section class="index-strip" aria-labelledby="index-strip-title" data-gallery-root>
      <p class="index-strip__label" id="index-strip-title">From the contact sheet</p>
      <ul class="index-strip__row">
        {
          stripFrames.map((frame) => (
            <li class="index-strip__frame">
              <a
                href={frame.href}
                data-gallery-trigger
                data-gallery-index={String(frame.index)}
                aria-haspopup="dialog"
              >
                <AstroImage
                  src={frame.asset}
                  alt={frame.alt}
                  widths={[240, 360, 480, 720]}
                  sizes={frame.sizes}
                  loading="lazy"
                  class="index-strip__img"
                />
                <span class="index-strip__cap">
                  <b>{frame.title}</b>
                  {frame.exposure && <ExposureLine class="index-strip__exif" value={frame.exposure} />}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="index-strip__more" href="/photography">Open the gallery →</a>
      <PhotographyLightbox galleryLightboxItemsJson={stripLightboxItemsJson} />
    </section>
  </section>

  <section class="posts">
    <p class="section-kicker">Notes</p>
    <h2 class="section-title">Latest posts</h2>
    {
      posts.length === 0 ? (
        <p class="text-muted">No posts yet.</p>
      ) : (
        <div class="post-grid">
          {posts.map((post, i) => (
            <article class={i === 0 ? "post-card post-card--featured card-link" : "post-card card-link"}>
              <div class="post-card-date">{formatDisplayDate(post.date)}</div>
              <h3 class="post-card-title"><a class="card-link__target" href={`/blog/${post.slug}`}>{post.title}</a></h3>
              <p class="post-card-desc">{post.description}</p>
            </article>
          ))}
        </div>
      )
    }
    <p class="mt-2">
      <a class="view-all" href="/blog">All notes →</a>
    </p>
  </section>
</BaseLayout>

<script>
  /* Keyboard focus in the contact strip: Chrome won't scroll a partly visible
     link any further, so a frame can sit under the right-edge fade. Align it
     to the row's start, the same edge the scroll-snap points use; a "nearest"
     scroll gets pulled back by proximity snapping. The row's scroll-padding
     covers the fade. Delegated on document because this module runs once
     across router page swaps. */
  document.addEventListener("focusin", (event) => {
    const link = (event.target as Element | null)?.closest?.(".index-strip__row a");
    const row = link?.closest(".index-strip__row");
    if (!(link instanceof HTMLElement) || !row || !link.matches(":focus-visible")) {
      return;
    }
    const fade = parseFloat(getComputedStyle(row).scrollPaddingInlineEnd) || 0;
    const linkBox = link.getBoundingClientRect();
    const rowBox = row.getBoundingClientRect();
    if (linkBox.left < rowBox.left || linkBox.right > rowBox.right - fade) {
      link.scrollIntoView({ block: "nearest", inline: "start" });
    }
  });
</script>
