---
import BaseLayout from "../../layouts/BaseLayout/BaseLayout.astro";
import { getCollection } from "astro:content";
import { formatDisplayDate } from "../../utils/date";
import { photographyGalleryData } from "../../data/photography";
import { photographyCategories } from "../../data/photography/manifest";
import { slugOf } from "../../utils/slug";
import "./_home.scss";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)
  .map((post) => ({
    slug: slugOf(post),
    title: post.data.title,
    description: post.data.description,
    date: post.data.date,
  }));

// Field-home: a photography-forward hero + a few featured shots from the gallery.
const featuredShots = photographyGalleryData
  .slice(0, 6)
  .map((img) => ({
    title: img.title,
    category: img.category,
    filename: img.filename,
  }));
const categoryLabel = (id: string) =>
  photographyCategories.find((c) => c.id === id)?.label ?? id;
---

<BaseLayout
  title="Ritik Patni — Frontend developer &amp; wildlife/macro photographer"
  description="I build thoughtful web experiences and document nature up close."
  path="/"
>
  <!-- Studio hero -->
  <section class="hero" data-home-slot="studio">
    <div class="hero-content">
      <h1 class="hero-name">Ritik <span class="fw-500">Patni</span></h1>
      <p class="hero-tagline">Building thoughtful product surfaces, systems, and shipping notes.</p>
      <span class="hero-accent">Frontend Developer</span>
    </div>
  </section>

  <!-- Field hero -->
  <section class="hero hero--field" data-home-slot="field">
    <div class="hero-content">
      <h1 class="hero-name">Field <span class="fw-500">Notes</span></h1>
      <p class="hero-tagline">Wildlife, birds, and macro studies — photographed in the field.</p>
      <span class="hero-accent">Photography</span>
    </div>
  </section>

  <!-- Studio: blog list -->
  <section class="posts" data-home-slot="studio">
    <h2 class="section-title">Latest posts</h2>
    {
      posts.length === 0 ? (
        <p class="text-muted">No posts yet.</p>
      ) : (
        <div class="post-grid">
          {posts.map((post, i) => (
            <article class={i === 0 ? "post-card post-card--featured" : "post-card"}>
              <div class="post-card-date">{formatDisplayDate(post.date)}</div>
              <h3 class="post-card-title"><a href={`/blog/${post.slug}`}>{post.title}</a></h3>
              <p class="post-card-desc">{post.description}</p>
            </article>
          ))}
        </div>
      )
    }
    <p class="mt-2">
      <a class="view-all" href="/blog">View all posts →</a>
    </p>
  </section>

  <!-- Field: featured shots -->
  <section class="posts field-home" data-home-slot="field">
    <h2 class="section-title">Recent frames</h2>
    <div class="field-home__grid">
      {
        featuredShots.map((shot) => (
          <a class="field-home__shot" href="/photography">
            <span class="field-home__shot-title">{shot.title}</span>
            <span class="field-home__shot-cat">{categoryLabel(shot.category)}</span>
          </a>
        ))
      }
    </div>
    <p class="mt-2">
      <a class="view-all" href="/photography">Open the gallery →</a>
    </p>
  </section>
</BaseLayout>
