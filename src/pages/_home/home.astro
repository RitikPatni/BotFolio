---
import { Image as AstroImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout/BaseLayout.astro";
import { getCollection } from "astro:content";
import { dateTimestamp, formatDisplayDate } from "../../utils/date";
import { photographyGalleryData } from "../../data/photography";
import { photographyCategories } from "../../data/photography/manifest";
import { slugOf } from "../../utils/slug";
import "./_home.scss";

const galleryAssetModules = import.meta.glob(
  "../../assets/photography/**/*.{avif,gif,jpeg,jpg,png,webp}",
  { eager: true },
) as Record<string, { default: ImageMetadata }>;

const galleryAssets = new Map(
  Object.entries(galleryAssetModules).map(([path, module]) => [
    path.replace("../../assets/photography/", ""),
    module.default,
  ]),
);

const heroBleedAsset = galleryAssets.get(
  "wildlife/sunset-silhouette-storks.jpg",
);

const featuredShots = photographyGalleryData
  .map((img) => {
    const assetModule = galleryAssets.get(`${img.category}/${img.filename}`);
    if (!(assetModule && img.alt)) return null;
    return {
      title: img.title,
      category: img.category,
      asset: assetModule,
      alt: img.alt,
    };
  })
  .filter((shot): shot is NonNullable<typeof shot> => shot !== null)
  .slice(0, 5);

const panoAsset = galleryAssets.get("wildlife/flamingo-flock-panorama.jpg");
const categoryLabel = (id: string) =>
  photographyCategories.find((c) => c.id === id)?.label ?? id;

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => dateTimestamp(b.data.date) - dateTimestamp(a.data.date))
  .slice(0, 3)
  .map((post) => ({
    slug: slugOf(post),
    title: post.data.title,
    description: post.data.description,
    date: post.data.date,
  }));
---

<BaseLayout
  title="Ritik Patni — Frontend developer &amp; wildlife/macro photographer"
  description="I build thoughtful web experiences and document nature up close."
  path="/"
>
  <section class="hero" data-hero="hzn" style={'--hz: 83.5dvh; --pos: 50% 100%'}>
    {heroBleedAsset && (
    <figure class="hero-bleed" aria-hidden="true">
      <AstroImage
        src={heroBleedAsset}
        alt="Two storks silhouetted in golden dusk light over still water"
        widths={[960, 1600, 2400]}
        sizes="100vw"
        loading="eager"
        class="hero-bleed-img"
      />
    </figure>
    )}
    <div class="hz-rule" aria-hidden="true"><span class="hz-right">field notes</span><span class="hz-below">dusk</span></div>
    <header class="hzn-mast">
      <h1 class="hero-name hzn-name">Storks</h1>
      <p class="hzn-lede">Ritik Patni — I build thoughtful product surfaces, and I document nature up close.</p>
    </header>
    <aside class="hzn-card">
      <a class="hero-cta" href="/blog">Read the notes →</a>
      <p class="hzn-card-note">field notes · photography journal</p>
    </aside>
  </section>

  <!-- Recent frames -->
  <section class="posts field-home">
    <p class="section-kicker">Photography</p>
    <h2 class="section-title">Recent frames</h2>
    <div class="field-home__grid">
      {
        featuredShots.map((shot) => (
          <a class="field-home__shot" href="/photography" aria-label={`${shot.title} — open gallery`}>
            <AstroImage
              src={shot.asset}
              alt={shot.alt}
              widths={[320, 640]}
              sizes="(max-width: 48rem) 45vw, 220px"
              loading="lazy"
              class="field-home__shot-img"
            />
            <span class="field-home__shot-title">{shot.title}</span>
            <span class="field-home__shot-cat">{categoryLabel(shot.category)}</span>
          </a>
        ))
      }
    </div>
    <p class="mt-2">
      <a class="view-all" href="/photography">Open the gallery →</a>
    </p>
  </section>

  <!-- Journal -->
  <section class="posts">
    <p class="section-kicker">Journal</p>
    <h2 class="section-title">Latest posts</h2>
    {
      posts.length === 0 ? (
        <p class="text-muted">No posts yet.</p>
      ) : (
        <div class="post-grid">
          {posts.map((post, i) => (
            <article class={i === 0 ? "post-card post-card--featured" : "post-card"}>
              <div class="post-card-date">{formatDisplayDate(post.date)}</div>
              <h3 class="post-card-title"><a href={`/blog/${post.slug}`}>{post.title}</a></h3>
              <p class="post-card-desc">{post.description}</p>
            </article>
          ))}
        </div>
      )
    }
    <p class="mt-2">
      <a class="view-all" href="/blog">View all posts →</a>
    </p>
  </section>
</BaseLayout>
