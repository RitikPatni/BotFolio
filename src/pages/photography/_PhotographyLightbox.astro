---
import UiIcon from "../../components/UiIcon.astro";
/* The viewer brings its own styles, so any page that mounts it (the gallery,
   the home strip) gets the same dialog without importing the gallery sheet. */
import "./_photography.lightbox.scss";

interface Props {
  galleryLightboxItemsJson: string;
}

const { galleryLightboxItemsJson } = Astro.props;
---

<dialog
  class="photography__lightbox"
  data-gallery-dialog
  aria-labelledby="galleryDialogTitle"
>
  <div
    class="photography__lightbox-shell"
    data-gallery-shell
    data-metadata-visible="false"
    data-ui-visible="true"
  >
    <p
      class="photography__gallery-status"
      data-gallery-status
      role="status"
      aria-live="polite"
      hidden
    ></p>
    <div
      class="photography__metadata-scrim"
      data-gallery-metadata-scrim
      aria-hidden="true"
    ></div>

    <div class="photography__lightbox-frame" data-gallery-frame>
      <!-- Stage: fills the frame and carries the zoom transform (Panzoom), so
           the photo inside stays free for the swipe drag's own transform. -->
      <div class="photography__lightbox-stage" data-gallery-stage>
        <img
          class="photography__lightbox-placeholder"
          data-gallery-placeholder
          alt=""
          aria-hidden="true"
          decoding="async"
          draggable="false"
          hidden
        />
        <!-- impeccable-disable broken-image -- lightbox placeholder: src is set at runtime by the gallery script -->
        <img
          class="photography__lightbox-image"
          data-gallery-image
          alt=""
          decoding="async"
          draggable="false"
        />
      </div>
    </div>

    <div class="photography__lightbox-topbar">
      <!-- Pager: prev / next flank the counter. On fine pointers the buttons
           break out into full-height edge zones; on touch they stay here, in
           the chrome, so screen-reader users (whose swipes the reader takes
           over) can still move between frames. -->
      <div class="photography__lightbox-pager">
        <button
          class="photography__lightbox-nav photography__lightbox-nav--prev"
          type="button"
          data-gallery-prev
          aria-label="Previous frame"
        >
          <UiIcon name="chevron-left" class="photography__nav-icon" />
        </button>
        <p class="photography__lightbox-counter" data-gallery-counter></p>
        <button
          class="photography__lightbox-nav photography__lightbox-nav--next"
          type="button"
          data-gallery-next
          aria-label="Next frame"
        >
          <UiIcon name="chevron-right" class="photography__nav-icon" />
        </button>
      </div>
      <div class="photography__lightbox-actions">
        <!-- Zoom: wheel, pinch and double-click/tap do the same; the buttons
             are the discoverable path (and +, -, 0 on the keyboard). -->
        <button
          class="photography__lightbox-action photography__lightbox-zoom"
          type="button"
          data-gallery-zoom-out
          aria-label="Zoom out"
          data-tooltip="Zoom out"
          aria-disabled="true"
        >
          <UiIcon name="zoom-out" class="photography__inline-icon" />
        </button>
        <button
          class="photography__lightbox-action photography__lightbox-zoom"
          type="button"
          data-gallery-zoom-in
          aria-label="Zoom in"
          data-tooltip="Zoom in"
        >
          <UiIcon name="zoom-in" class="photography__inline-icon" />
        </button>
        <button
          class="photography__lightbox-action"
          type="button"
          data-gallery-fullscreen-toggle
          aria-label="Full screen"
          data-tooltip="Full screen"
        >
          <UiIcon name="expand" class="photography__inline-icon" />
        </button>
        <button
          class="photography__lightbox-action"
          type="button"
          data-gallery-metadata-toggle
          aria-expanded="false"
          aria-controls="galleryMetadata"
          aria-label="Show metadata"
          data-tooltip="Show metadata"
        >
          <UiIcon name="info" class="photography__inline-icon" />
        </button>
        <button
          class="photography__lightbox-close"
          type="button"
          data-gallery-close
          aria-label="Close gallery"
          data-tooltip="Close gallery"
          autofocus
        >
          <UiIcon name="close" class="photography__inline-icon" />
        </button>
      </div>
    </div>

    <!-- Journal caption: the contact-sheet tag (serif title, mono EXIF) on ink. -->
    <div class="photography__lightbox-caption" data-gallery-caption>
      <h2
        class="photography__lightbox-title"
        id="galleryDialogTitle"
        data-gallery-title
      >
      </h2>
      <p class="photography__lightbox-caption-meta" data-gallery-caption-meta></p>
    </div>

    <aside
      class="photography__metadata"
      id="galleryMetadata"
      data-gallery-metadata
    >
      <div class="photography__metadata-head">
        <h3 class="photography__metadata-title">
          <UiIcon name="info" class="photography__inline-icon" />
          Metadata
        </h3>
        <button
          class="photography__metadata-close"
          type="button"
          data-gallery-metadata-close
          aria-label="Close metadata"
        >
          <UiIcon name="close" class="photography__inline-icon" />
        </button>
      </div>
      <div class="photography__metadata-content">
        <dl class="photography__metadata-list" data-gallery-metadata-list></dl>
        <section
          class="photography__metadata-section"
          data-gallery-tags-section
          hidden
        >
          <h4 class="photography__metadata-subtitle">Tags</h4>
          <div class="photography__metadata-tags" data-gallery-tag-list></div>
        </section>
        <section
          class="photography__metadata-section"
          data-gallery-related
          hidden
        >
          <h4 class="photography__metadata-subtitle" data-gallery-related-title>
          </h4>
          <div class="photography__related-grid" data-gallery-related-grid>
          </div>
        </section>
      </div>
    </aside>
  </div>
</dialog>

<script
  is:inline
  type="application/json"
  id="photographyGalleryData"
  set:html={galleryLightboxItemsJson}
/>

<script>
  import { bindPhotographyLightbox } from "../../utils/photography/photographyLightbox.client";

  bindPhotographyLightbox();
</script>
