---
import BaseLayout from "../../layouts/BaseLayout/BaseLayout.astro";
import { Image, getImage } from "astro:assets";
import PhotographyLightbox from "./_PhotographyLightbox.astro";
import "./_photography.scss";

import {
  photographyGalleryData,
  type GalleryImage,
  type PhotoMetadata,
} from "../../data/photography";
import { photographyCategories } from "../../data/photography/manifest";
import type {
  GalleryDialogImage,
  GalleryLightboxMetadata,
} from "../../utils/photography/photographyLightbox.types";

type GalleryAssetModule = {
  default: ImageMetadata;
};

type CategoryGalleryImage = {
  asset: ImageMetadata;
  alt: string;
  title: string;
  tags: string[];
  lightboxIndex: number;
  ratio: number;
  exposure: string;
};

type CategoryGallerySection = {
  id: string;
  label: string;
  description: string;
  images: CategoryGalleryImage[];
};

const typedGallery: GalleryImage[] = photographyGalleryData;

const galleryAssetModules = import.meta.glob<GalleryAssetModule>(
  "../../assets/photography/**/*.{avif,gif,jpeg,jpg,png,webp}",
  { eager: true },
);

const galleryAssets = new Map(
  Object.entries(galleryAssetModules).map(([path, module]) => [
    path.replace("../../assets/photography/", ""),
    module.default,
  ]),
);

/* Contact-sheet caption: one exposure line from the frame's own EXIF (same
   rule as the home strip); missing fields are omitted, never filled in. */
const exposureOf = (meta?: PhotoMetadata) =>
  [meta?.aperture, meta?.shutterSpeed, meta?.iso != null ? `ISO ${meta.iso}` : undefined]
    .filter(Boolean)
    .join(" · ");

const createLightboxMetadata = (
  image: GalleryImage,
  categoryLabel: string,
  asset: ImageMetadata,
) => {
  return {
    date: image.date || undefined,
    camera: image.metadata?.camera,
    lens: image.metadata?.lens,
    focalLength: image.metadata?.focalLength,
    aperture: image.metadata?.aperture,
    shutterSpeed: image.metadata?.shutterSpeed,
    iso: image.metadata?.iso ? String(image.metadata.iso) : undefined,
    category: categoryLabel,
    resolution: `${asset.width} × ${asset.height}`,
  } satisfies GalleryLightboxMetadata;
};

let lightboxIndex = 0;
const imagesByCategory: CategoryGallerySection[] = [];
const galleryLightboxItems: GalleryDialogImage[] = [];
const frameSlugs = new Set<string>();

for (const category of photographyCategories) {
  const categoryImages = typedGallery.filter(
    (img) => img.category === category.id,
  );
  const images = [];

  for (const image of categoryImages) {
    const assetPath = `${category.id}/${image.filename}`;
    const asset = galleryAssets.get(assetPath);

    if (!asset) {
      throw new Error(`Missing photography asset: ${assetPath}`);
    }

    const lightboxImage = await getImage({
      src: asset,
      widths: [960, 1440, 1920],
      sizes: "92vw",
      quality: "high",
    });

    const relatedThumb = await getImage({
      src: asset,
      width: 240,
      quality: "high",
    });

    /* Deep-link id (/photography#<slug>): the asset filename sans extension. */
    const slug = image.filename.replace(/\.[^.]+$/, "");

    if (frameSlugs.has(slug)) {
      throw new Error(`Duplicate photography frame slug: ${slug}`);
    }
    frameSlugs.add(slug);

    const exposure = exposureOf(image.metadata);
    const metadataEntries = createLightboxMetadata(
      image,
      category.label,
      asset,
    );
    const galleryItem = {
      index: lightboxIndex,
      slug,
      title: image.title,
      alt: image.alt,
      category: category.label,
      date: image.date,
      src: lightboxImage.src,
      srcSet: lightboxImage.srcSet.attribute,
      thumbSrc: relatedThumb.src,
      width: Number(lightboxImage.attributes.width),
      height: Number(lightboxImage.attributes.height),
      exposure,
      metadata: metadataEntries,
      tags: image.tags,
    } satisfies GalleryDialogImage;

    galleryLightboxItems.push(galleryItem);
    images.push({
      asset,
      alt: image.alt,
      title: image.title,
      tags: image.tags,
      lightboxIndex,
      ratio: asset.width / asset.height,
      exposure,
    });

    lightboxIndex += 1;
  }

  imagesByCategory.push({ ...category, images });
}

const visibleCategories: CategoryGallerySection[] = imagesByCategory.filter(
  (category) => category.images.length > 0,
);
const totalImages = typedGallery.length;
const galleryLightboxItemsJson = JSON.stringify(galleryLightboxItems);
---

<BaseLayout title="Gallery — Ritik Patni" path="/photography">
  <div class="photography" data-gallery-root>
    <section class="photography__hero page-hero page-hero--standard">
      <div class="page-hero__inner">
        <h1 class="photography__title page-hero__title">Gallery</h1>
        <p class="photography__lead page-hero__lead">
          Field notes in frames. Wildlife, birds, and macro studies from recent
          sessions.
        </p>
      </div>
    </section>

    {
      visibleCategories.length > 0 && (
        <nav class="photography__index" aria-label="Gallery sections">
          <span class="photography__index-total">{totalImages} frames</span>
          {visibleCategories.map((category: CategoryGallerySection) => (
            <a class="photography__index-link" href={`#${category.id}`}>
              {category.label} <span class="photography__index-count">{category.images.length}</span>
            </a>
          ))}
        </nav>
      )
    }

    {
      totalImages === 0 && (
        <p class="photography__empty">
          No frames yet. Add images under <code>src/assets/photography/&lt;category&gt;</code>
          and their entries in <code>src/data/photography</code>.
        </p>
      )
    }

    {
      visibleCategories.map(
        (category: CategoryGallerySection, categoryIndex) => (
          <section
            class="photography__category"
            id={category.id}
            aria-labelledby={`${category.id}-title`}
          >
            <header class="photography__category-head">
              <h2 class="photography__section-title" id={`${category.id}-title`}>
                {category.label}
              </h2>
              <p class="photography__meta">
                {category.images.length} {category.images.length === 1 ? "frame" : "frames"} · {category.description}
              </p>
            </header>

            <ul class="photography__sheet">
              {category.images.map(
                (image: CategoryGalleryImage, imageIndex: number) => (
                  <li class="photography__frame" style={`--ar: ${image.ratio.toFixed(4)}`}>
                    <figure class="photography__shot">
                      <button
                        class="photography__shot-link"
                        type="button"
                        data-gallery-trigger
                        data-gallery-index={String(image.lightboxIndex)}
                        aria-haspopup="dialog"
                        aria-label={`Open ${image.title} in gallery view`}
                      >
                        <Image
                          class="photography__image"
                          src={image.asset}
                          alt={image.alt}
                          widths={[480, 720, 1080]}
                          sizes={`(max-width: 48rem) 100vw, ${Math.ceil(image.ratio * 360)}px`}
                          quality="high"
                          loading={
                            categoryIndex === 0 && imageIndex < 2
                              ? "eager"
                              : "lazy"
                          }
                          fetchpriority={
                            categoryIndex === 0 && imageIndex === 0
                              ? "high"
                              : "auto"
                          }
                        />
                      </button>
                      <figcaption class="photography__caption">
                        <span class="photography__caption-title">{image.title}</span>
                        {image.exposure && (
                          <span class="photography__caption-exif">{image.exposure}</span>
                        )}
                      </figcaption>
                    </figure>
                  </li>
                ),
              )}
            </ul>
          </section>
        ),
      )
    }

    <PhotographyLightbox galleryLightboxItemsJson={galleryLightboxItemsJson} />
  </div>
</BaseLayout>
