---
import BaseLayout from "../../layouts/BaseLayout/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { readingTimeMinutes } from "../../utils/readingTime";
import { formatDisplayDate } from "../../utils/date";
import { excerpt } from "../../utils/excerpt";
import { slugOf } from "../../utils/slug";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const reading = readingTimeMinutes(post.body ?? "");
const STANDARD_SITE_DID = "did:plc:53jkze3ofomdesnodoz5i34y";
const standardSiteDocUri = `at://${STANDARD_SITE_DID}/site.standard.document/${slugOf(post)}`;
import "./_slug.scss";
---

<BaseLayout
  title={`${post.data.title} — Writing`}
  description={post.data.description}
  path={`/blog/${slugOf(post)}`}
  image={`/og/blog/${slugOf(post)}.png`}
  ogType="article"
>
  <link
    slot="head"
    rel="site.standard.document"
    href={standardSiteDocUri}
  />
  <section class="slug-hero page-hero page-hero--detail">
    <div class="slug-hero-content page-hero__inner">
      <p class="slug-hero-meta page-hero__meta">
        {formatDisplayDate(post.data.date)} · {post.data.authors.join(" & ")} ·{" "}
        {reading} min read
      </p>
      <h1 class="slug-hero-title page-hero__title">{post.data.title}</h1>
      <p class="slug-hero-lead page-hero__lead">{excerpt(post.data.description)}</p>
    </div>
  </section>

  <!-- Prose content — wider column -->
  <article class="slug-prose">
    <Content />
  </article>
</BaseLayout>
