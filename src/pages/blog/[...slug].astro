---
import crypto from "node:crypto";
import BaseLayout from "../../layouts/BaseLayout/BaseLayout.astro";
import FloatingLikeButton from "../../components/FloatingLikeButton.astro";
import { getCollection, render } from "astro:content";
import { readingTimeMinutes } from "../../utils/readingTime";
import { formatDisplayDate } from "../../utils/date";
import { excerpt, stripMarkdown } from "../../utils/excerpt";
import { slugOf } from "../../utils/slug";
import { documentUri } from "../../utils/standardSite.mjs";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const reading = readingTimeMinutes(post.body ?? "");
/* Imported descriptions are often the post's opening sentence; showing it as
   the lead too would print it twice. Keep it for the meta description only. */
const leadKey = stripMarkdown(post.data.description).replace(/(\.\.\.|…)$/, "").trim();
const showLead = Boolean(leadKey) && !stripMarkdown(post.body ?? "").startsWith(leadKey);
// OG cache-bust: the PNG endpoint URL changes whenever title/description/date change,
// so platform embed caches (Discord, Twitter) refetch instead of serving a stale card.
// OG_TEMPLATE changes when the card design itself changes (e.g. its typeface).
const OG_TEMPLATE = "newsreader-2";
const ogVersion = crypto
  .createHash("sha256")
  .update(`${OG_TEMPLATE}|${post.data.title}|${post.data.description}|${post.data.date}`)
  .digest("hex")
  .slice(0, 8);
const ogImage = `/og/blog/${slugOf(post)}.png?v=${ogVersion}`;
// Same key the publish script writes, so the page names its real record.
const standardSiteDocUri = documentUri(slugOf(post), post.data.date);
import "./_slug.scss";
import "./_floating-like.scss";
---

<BaseLayout
  title={`${post.data.title} · Notes`}
  description={post.data.description}
  path={`/blog/${slugOf(post)}`}
  image={ogImage}
  ogType="article"
>
  <link
    slot="head"
    rel="site.standard.document"
    href={standardSiteDocUri}
  />
  <section class="slug-hero page-hero page-hero--detail">
    <div class="slug-hero-content page-hero__inner">
      <p class="slug-hero-meta page-hero__meta">
        {formatDisplayDate(post.data.date)} · {post.data.authors.join(" & ")} ·{" "}
        {reading} min read
      </p>
      <h1 class="slug-hero-title page-hero__title">{post.data.title}</h1>
      {showLead && <p class="slug-hero-lead page-hero__lead">{excerpt(post.data.description)}</p>}
    </div>
  </section>

  <!-- Prose content — wider column -->
  <article class="slug-prose">
    <Content />
  </article>

  <FloatingLikeButton slug={slugOf(post)} title={post.data.title} />
</BaseLayout>
