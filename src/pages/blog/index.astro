---
import BaseLayout from "../../layouts/BaseLayout/BaseLayout.astro";
import { getCollection } from "astro:content";
import { readingTimeMinutes } from "../../utils/readingTime";
import { formatDisplayDate } from "../../utils/date";
import { excerpt } from "../../utils/excerpt";
import { slugOf } from "../../utils/slug";

const blogPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .map((post) => {
    const words = post.body ?? "";
    return {
      slug: `/blog/${slugOf(post)}`,
      title: post.data.title,
      description: excerpt(post.data.description),
      date: post.data.date,
      readingTime: readingTimeMinutes(words),
      category: post.data.category || "blog",
    };
  });

const newsletterPosts = (await getCollection("newsletter"))
  .map((post) => {
    const words = post.body ?? "";
    return {
      slug: `/newsletter/${slugOf(post)}`,
      title: post.data.title,
      description: excerpt(post.data.description),
      date: post.data.date,
      readingTime: readingTimeMinutes(words),
      category: "newsletter",
    };
  });

const posts = [...blogPosts, ...newsletterPosts]
  .sort((a, b) => b.date.getTime() - a.date.getTime());

const categories = ["all", "blog", "newsletter"];
import "./_blog.scss";
---

<BaseLayout title="Writing — Ritik Patni" path="/blog">
  <!-- Gradient hero -->
  <section class="blog-hero">
    <div class="blog-hero-content">
      <h1 class="blog-hero-title">Writing</h1>
      <p class="blog-hero-lead">Clean notes on frontend engineering, systems, and photography.</p>
    </div>
  </section>

  <!-- Filter pills -->
  <div class="blog-filters">
    {categories.map((cat) => (
      <a href={`/blog${cat === 'all' ? '' : `?category=${cat}`}`} class="blog-filter-pill">{cat === 'all' ? 'All' : cat.charAt(0).toUpperCase() + cat.slice(1)}</a>
    ))}
  </div>

  <!-- Blog list -->
  <section class="blog-posts">
    {
      posts.length === 0 ? (
        <p class="text-muted">No posts yet.</p>
      ) : (
        <div class="blog-grid">
          {posts.map((post, i) => (
            <article class={i === 0 ? "blog-card blog-card--featured" : "blog-card"}>
              <div class="blog-card-date">{formatDisplayDate(post.date)}</div>
              <h2 class="blog-card-title"><a href={post.slug}>{post.title}</a></h2>
              <p class="blog-card-desc">{post.description}</p>
              <p class="blog-card-meta">{post.readingTime} min read</p>
            </article>
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
