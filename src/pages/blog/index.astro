---
import BaseLayout from "../../layouts/BaseLayout/BaseLayout.astro";
import { getCollection } from "astro:content";
import { readingTimeMinutes } from "../../utils/readingTime";
import { dateTimestamp, formatDayMonth, isoDate, toDate } from "../../utils/date";
import { excerpt } from "../../utils/excerpt";
import { slugOf } from "../../utils/slug";

const GENERIC_READING_DESCRIPTION = "What I'm reading this week.";

/* The weekly digest's links, by title: "Taking Back CSS-Tricks, ...". Site
   names after " – " or " | " are dropped; the author follows each link. */
const readingListSummary = (body: string) =>
  [...body.matchAll(/^- \[([^\]]+)\]\(/gm)]
    .map(([, title]) => title.split(/ [–|] /)[0].trim())
    .filter((title) => !/^share on /i.test(title))
    .join(", ");

const blogPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .map((post) => {
    const words = post.body ?? "";
    const isReadingList = post.data.tags.includes("weekly");
    const description =
      isReadingList && post.data.description === GENERIC_READING_DESCRIPTION
        ? readingListSummary(words) || post.data.description
        : post.data.description;
    return {
      slug: `/blog/${slugOf(post)}`,
      title: post.data.title,
      description: excerpt(description),
      date: post.data.date,
      readingTime: readingTimeMinutes(words),
      category: isReadingList ? "reading" : "blog",
    };
  });

const newsletterPosts = (await getCollection("newsletter"))
  .filter((post) => !post.data.draft)
  .map((post) => {
    const words = post.body ?? "";
    return {
      slug: `/newsletter/${slugOf(post)}`,
      title: post.data.title,
      description: excerpt(post.data.description),
      date: post.data.date,
      readingTime: readingTimeMinutes(words),
      category: "newsletter",
    };
  });

const posts = [...blogPosts, ...newsletterPosts]
  .sort((a, b) => dateTimestamp(b.date) - dateTimestamp(a.date));

const categories = ["all", "blog", "reading", "newsletter"];
const categoryLabel: Record<string, string> = {
  all: "All",
  blog: "Blog",
  reading: "Reading lists",
  newsletter: "Newsletter",
};
/* Singular, for the label on each row. */
const rowLabel: Record<string, string> = {
  blog: "Blog",
  reading: "Reading list",
  newsletter: "Newsletter",
};
const pageDescription = "Notes on frontend engineering, plus weekly reading lists.";
const requestedCategory = Astro.url.searchParams.get("category");
const selectedCategory = categories.includes(requestedCategory ?? "")
  ? requestedCategory!
  : "all";
const visiblePosts =
  selectedCategory === "all"
    ? posts
    : posts.filter((post) => post.category === selectedCategory);

/* Newest year first; posts are already sorted newest first. */
const years = [...new Set(visiblePosts.map((post) => toDate(post.date).getUTCFullYear()))];
const postsByYear = years.map((year) => ({
  year,
  posts: visiblePosts.filter((post) => toDate(post.date).getUTCFullYear() === year),
}));
import "./_blog.scss";
---

<BaseLayout
  title="Notes · Ritik Patni"
  description={pageDescription}
  image="/og/notes.png"
  path="/blog"
>
  <section class="blog-hero page-hero page-hero--standard">
    <div class="blog-hero-content page-hero__inner">
      <h1 class="blog-hero-title page-hero__title">Notes</h1>
      <p class="blog-hero-lead page-hero__lead">{pageDescription}</p>
    </div>
  </section>

  <!-- Filter pills -->
  <div class="blog-filters">
    {categories.map((cat) => (
      <a
        href={`/blog${cat === "all" ? "" : `?category=${cat}`}`}
        data-blog-filter={cat}
        class:list={["blog-filter-pill", { "is-active": selectedCategory === cat }]}
        aria-current={selectedCategory === cat ? "page" : undefined}
      >
        {categoryLabel[cat]}
      </a>
    ))}
  </div>
  <p class="visually-hidden" role="status" aria-live="polite" data-blog-filter-status></p>

  <!-- Notes list, grouped by year -->
  <section class="blog-posts" aria-label="Posts">
    {
      visiblePosts.length === 0 ? (
        <p class="text-muted">No posts yet.</p>
      ) : (
        postsByYear.map(({ year, posts: yearPosts }) => (
          <section class="blog-year" data-blog-year aria-labelledby={`blog-year-${year}`}>
            <h2 class="blog-year__title" id={`blog-year-${year}`}>{year}</h2>
            <div class="blog-list">
              {yearPosts.map((post) => (
                <article class="blog-card blog-row card-link" data-blog-card-category={post.category}>
                  <time class="blog-card-date" datetime={isoDate(post.date)}>{formatDayMonth(post.date)}</time>
                  <div class="blog-row__body">
                    <h3 class="blog-card-title"><a class="card-link__target" href={post.slug}>{post.title}</a></h3>
                    {post.description && <p class="blog-card-desc">{post.description}</p>}
                    <p class="blog-card-meta">
                      {rowLabel[post.category] ?? "Blog"} · {post.readingTime} min read
                    </p>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))
      )
    }
    <p class="text-muted blog-empty" data-blog-empty hidden>No posts in this category yet.</p>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const filters = [...document.querySelectorAll("[data-blog-filter]")];
    const cards = [...document.querySelectorAll("[data-blog-card-category]")];
    const status = document.querySelector("[data-blog-filter-status]");
    const years = [...document.querySelectorAll("[data-blog-year]")];
    const empty = document.querySelector("[data-blog-empty]");
    if (!filters.length || !cards.length) return;

    /* ClientRouter re-runs this inline script on every visit: drop the
       previous visit's window listener, and this one when the page leaves. */
    window.__rpBlogFilterAbort?.abort();
    const lifecycle = new AbortController();
    window.__rpBlogFilterAbort = lifecycle;
    document.addEventListener("astro:before-swap", () => lifecycle.abort(), {
      once: true,
      signal: lifecycle.signal,
    });

    /* announce: only for a visitor's own filter change, not the initial render. */
    const applyFilter = (category, updateUrl, announce = updateUrl) => {
      const validCategory = ["all", "blog", "reading", "newsletter"].includes(category)
        ? category
        : "all";
      const visibleCards = cards.filter(
        (card) =>
          validCategory === "all" ||
          card.dataset.blogCardCategory === validCategory,
      );

      cards.forEach((card) => {
        card.hidden = !visibleCards.includes(card);
      });
      /* A year heading with nothing under it would read as an empty year. */
      years.forEach((year) => {
        year.hidden = !year.querySelector("[data-blog-card-category]:not([hidden])");
      });
      if (empty) empty.hidden = visibleCards.length > 0;
      filters.forEach((filter) => {
        const active = filter.dataset.blogFilter === validCategory;
        filter.classList.toggle("is-active", active);
        if (active) filter.setAttribute("aria-current", "page");
        else filter.removeAttribute("aria-current");
      });

      if (announce && status) {
        const count = visibleCards.length;
        status.textContent = `${count} ${count === 1 ? "post" : "posts"}`;
      }

      if (updateUrl) {
        const url = new URL(window.location.href);
        if (validCategory === "all") url.searchParams.delete("category");
        else url.searchParams.set("category", validCategory);
        window.history.pushState({}, "", url);
      }
    };

    filters.forEach((filter) => {
      filter.addEventListener("click", (event) => {
        event.preventDefault();
        applyFilter(filter.dataset.blogFilter || "all", true);
      });
    });
    window.addEventListener(
      "popstate",
      () => {
        applyFilter(new URL(window.location.href).searchParams.get("category") || "all", false, true);
      },
      { signal: lifecycle.signal },
    );
    applyFilter(new URL(window.location.href).searchParams.get("category") || "all", false);
  })();
</script>
