---
import BaseLayout from "../../layouts/BaseLayout/BaseLayout.astro";
import { getCollection } from "astro:content";
import { readingTimeMinutes } from "../../utils/readingTime";
import { dateTimestamp, formatDisplayDate } from "../../utils/date";
import { excerpt } from "../../utils/excerpt";
import { slugOf } from "../../utils/slug";

const entries = (await getCollection("newsletter"))
  .filter((item) => !item.data.draft)
  .sort((a, b) => dateTimestamp(b.data.date) - dateTimestamp(a.data.date))
  .map((item) => ({
    slug: slugOf(item),
    title: item.data.title,
    description: excerpt(item.data.description),
    date: item.data.date,
    readingTime: readingTimeMinutes(item.body ?? ""),
  }));
import "./_newsletter.scss";
---

<BaseLayout title="Newsletter Archive — Ritik Patni" path="/newsletter">
  <div class="newsletter">
    <section class="newsletter__hero page-hero page-hero--standard">
      <div class="page-hero__inner">
        <h1 class="newsletter__title page-hero__title">Newsletter Archive</h1>
        <p class="newsletter__lead page-hero__lead">
          Complete Buttondown archive mirrored into this site.
        </p>
      </div>
    </section>

    <section class="newsletter__list">
      {
        entries.length === 0 ? (
          <article class="newsletter__card">
            <p>No newsletter entries yet.</p>
          </article>
        ) : (
          entries.map((item) => (
            <article class="newsletter__item">
              <h2 class="newsletter__item-title">
                <a href={`/newsletter/${item.slug}`}>{item.title}</a>
              </h2>
              <p class="newsletter__meta newsletter__meta--spaced">
                {formatDisplayDate(item.date)} · {item.readingTime} min read
              </p>
              <p class="newsletter__description">{item.description}</p>
            </article>
          ))
        )
      }
    </section>

    <section class="newsletter__subscribe">
      <h2 class="newsletter__subscribe-title">Subscribe</h2>
      <p class="newsletter__subscribe-lead">
        Two independent ways to follow new writing — pick either, they don't
        depend on each other.
      </p>
      <ul class="newsletter__subscribe-list">
        <li>
          <strong>RSS</strong> — for any feed reader. The full archive is
          available as a standard RSS feed:
          <a href="/rss.xml">ritikpatni.me/rss.xml</a>.
        </li>
        <li>
          <strong>AT Protocol (Standard.site)</strong> — for AT-native clients.
          Every post is published as a <code>site.standard.document</code> record
          to the channel below; an AT Proto reader can subscribe directly and
          receive new posts without polling this site.
          <br />
          <span class="newsletter__subscribe-aturi">
            Publication: <code>at://did:plc:53jkze3ofomdesnodoz5i34y/site.standard.publication</code>
          </span>
          <br />
          <a
            href="https://bsky.social/xrpc/com.atproto.repo.listRecords?repo=ritikpatni.bsky.social&collection=site.standard.document"
          >
            View published records
          </a>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>
