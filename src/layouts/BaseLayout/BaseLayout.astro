---
/* Fonts are self-hosted (Fontsource): no third-party stylesheet blocking first
   paint, and the main face is preloaded below. */
import "@fontsource-variable/schibsted-grotesk/wght.css";
import "@fontsource-variable/schibsted-grotesk/wght-italic.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import schibstedLatinUrl from "@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url";
import "../../styles/global.scss";
import "./BaseLayout.scss";
import { SITE_CONFIG, NAV_LINKS } from "../../config/site";
import { ClientRouter } from "astro:transitions";
import SocialIcon from "../../components/SocialIcon.astro";
import UiIcon from "../../components/UiIcon.astro";

interface Props {
  title: string;
  description?: string;
  path?: string;
  image?: string;
  ogType?: string;
  /** Error pages: robots noindex and no canonical. */
  noindex?: boolean;
}

const {
  title,
  description = SITE_CONFIG.defaultDescription,
  path = "/",
  image = "/og/default.png",
  ogType = "website",
  noindex = false,
} = Astro.props;

const socials = SITE_CONFIG.socials;
const normalizedPath = path.replace(/\/$/, "") || "/";
const isNavLinkActive = (href: string) =>
  href === "/"
    ? normalizedPath === "/"
    : normalizedPath === href || normalizedPath.startsWith(`${href}/`);
const canonicalUrl = new URL(path, Astro.site).toString();
const imageUrl = new URL(image, Astro.site).toString();
---

<!doctype html>
<html
  lang="en"
  data-theme="light"
  transition:name="page-root"
  transition:animate="none"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (() => {
        const THEME_STORAGE_KEY = "rp-theme";

        /* Theme is visitor-owned, never page-owned: stored choice → system
           preference → light. The server renders "light" only as the no-JS
           fallback; this runs before first paint and again on every
           ClientRouter swap so the incoming page's attribute never wins. */
        const resolveTheme = () => {
          try {
            const savedTheme = localStorage.getItem(THEME_STORAGE_KEY);

            if (savedTheme === "light" || savedTheme === "dark") {
              return savedTheme;
            }
          } catch {
            // Ignore storage access errors; fall through to the system theme.
          }

          try {
            return window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
          } catch {
            return "light";
          }
        };

        document.documentElement.setAttribute("data-theme", resolveTheme());

        if (!window.__rpGalleryFeedbackBound) {
          document.addEventListener(
            "click",
            (event) => {
              const target = event.target;
              const trigger =
                target instanceof Element
                  ? target.closest("[data-gallery-trigger]")
                  : null;
              const root = trigger?.closest("[data-gallery-root]");
              const status = root?.querySelector("[data-gallery-open-status]");

              if (
                !(trigger instanceof HTMLElement) ||
                !(root instanceof HTMLElement) ||
                !(status instanceof HTMLElement)
              ) {
                return;
              }

              const requestId = String(Date.now());
              status.dataset.galleryRequest = requestId;
              trigger.setAttribute("aria-busy", "true");
              status.hidden = false;
              status.textContent = "Opening gallery…";

              window.setTimeout(() => {
                if (
                  status.dataset.galleryRequest === requestId &&
                  !root.querySelector("dialog[open]")
                ) {
                  status.textContent = "Gallery is still loading…";
                }
              }, 700);

              window.setTimeout(() => {
                if (
                  status.dataset.galleryRequest === requestId &&
                  !root.querySelector("dialog[open]")
                ) {
                  status.textContent =
                    "Gallery is taking longer than expected. Try again.";
                }
              }, 4000);
            },
            true,
          );
          window.__rpGalleryFeedbackBound = true;
        }

        if (!window.__rpBrokenImageBound) {
          /* Imported notes embed third-party images (tweet avatars and media)
             that have since been deleted: hide a content image that fails to
             load instead of showing a broken-image icon. Image errors don't
             bubble, hence capture. Inline style, because content rules set
             img { display: block } and would beat the hidden attribute. */
          document.addEventListener(
            "error",
            (event) => {
              const img = event.target;
              if (
                img instanceof HTMLImageElement &&
                img.closest(".slug__content, .slug-prose, .prose")
              ) {
                img.style.display = "none";
              }
            },
            true,
          );
          window.__rpBrokenImageBound = true;
        }

        if (!window.__rpThemeSwapHookBound) {
          /* Stamp the incoming document before it is swapped in (no frame of
             the server default), then re-assert after the root attributes
             have been copied across. */
          document.addEventListener("astro:before-swap", (event) => {
            event.newDocument.documentElement.setAttribute(
              "data-theme",
              resolveTheme(),
            );
          });
          document.addEventListener("astro:after-swap", () => {
            document.documentElement.setAttribute("data-theme", resolveTheme());
          });
          window.__rpThemeSwapHookBound = true;
        }
      })();
    </script>
    <link
      rel="preload"
      href={schibstedLatinUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-light-32x32.png"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-dark-32x32.png"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon-light-16x16.png"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon-dark-16x16.png"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" type="image/x-icon" href="/favicon-light.ico" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon-light.png"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_CONFIG.personName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="color-scheme" content="dark light" />
    <meta
      name="theme-color"
      content="#eeefed"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#141516"
      media="(prefers-color-scheme: dark)"
    />
    <ClientRouter />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_CONFIG.rssTitle}
      href="/rss.xml"
    />
    <script
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="1954c052-315e-42e7-bf31-c803cf2cd164"
    ></script>
    <slot name="head" />
  </head>
  <body>
    <div class="base-layout" data-page-shell>
      <a class="base-layout__skip-link" href="#main-content">Skip to content</a>
      <header class="base-layout__header">
        <div class="base-layout__container base-layout__bar">
          <a class="base-layout__brand" href="/" aria-label="Go to profile home">
            <strong>{SITE_CONFIG.personName}</strong>
          </a>
          <div class="base-layout__nav-wrap">
            <nav class="nav-links" aria-label="Main navigation" data-nav-scroller>
              {NAV_LINKS.map(item => (
                <a href={item.href} class={isNavLinkActive(item.href) ? 'nav-link active' : 'nav-link'} aria-current={isNavLinkActive(item.href) ? 'page' : undefined}>{item.label}</a>
              ))}
            </nav>
            <button class="nav-scroll-hint" type="button" data-nav-scroll-hint hidden aria-label="Show more navigation links">More <span aria-hidden="true">→</span></button>
          </div>
          <button
            class="base-layout__theme-toggle"
            type="button"
            id="themeToggle"
            aria-label="Toggle light and dark theme"
            title="Toggle theme"
          >
            <UiIcon name="moon" class="base-layout__theme-icon base-layout__theme-icon--moon" />
            <UiIcon name="sun" class="base-layout__theme-icon base-layout__theme-icon--sun" />
          </button>
        </div>
      </header>

      <main
        id="main-content"
        role="main"
        class="base-layout__container base-layout__main"
        transition:name="page-content"
        transition:animate="none"
      >
        <slot />
      </main>

      <footer class="base-layout__footer">
        <div class="base-layout__container base-layout__footer-content">
          <p class="base-layout__footer-copy">
            © {new Date().getFullYear()}
            {" "}
            {SITE_CONFIG.personName} · Built with Astro.
          </p>
          <nav class="base-layout__socials" aria-label="Social links">
            {
              socials.map((social) => {
                const isMailto = social.href.startsWith("mailto:");
                return (
                  <a
                    href={social.href}
                    class="base-layout__social-link"
                    target={isMailto ? undefined : "_blank"}
                    rel={isMailto ? undefined : "noreferrer noopener"}
                  >
                    <SocialIcon
                      name={social.icon}
                      class="base-layout__social-icon"
                    />
                    {social.label}
                    {!isMailto && (
                      <span class="visually-hidden"> (opens in new tab)</span>
                    )}
                  </a>
                );
              })
            }
          </nav>
        </div>
      </footer>
    </div>

    <script>
      import { initBaseLayoutClient } from "../../utils/layout/baseLayout.client";

      initBaseLayoutClient({ animateReveals: true });
      document.addEventListener("DOMContentLoaded", () => {
        initBaseLayoutClient({ animateReveals: true });
      });
      document.addEventListener("astro:page-load", () => {
        initBaseLayoutClient({ animateReveals: false });
      });
    </script>
  </body>
</html>
