---
/** Floating like control for blog posts. No control is rendered without a slug. */
interface Props {
  slug: string;
  title: string;
}

const { slug, title } = Astro.props;
---

{
  slug && (
  <aside class="floating-like" data-floating-like data-like-slug={slug} hidden>
      <button
        class="floating-like__button"
        data-like-button
        data-like-slug={slug}
        data-like-count={0}
        data-like-mine={0}
        type="button"
        aria-label={`Like “${title}”`}
        aria-describedby={`like-status-${slug}`}
      >
        <span class="floating-like__heart" data-like-heart aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path
              d="M12 20.5c-.2 0-.4-.05-.55-.16C6.4 16.6 3 13.4 3 9.7 3 6.9 5.1 5 7.5 5c1.7 0 3.3.9 4.5 2.6C13.2 5.9 14.8 5 16.5 5 18.9 5 21 6.9 21 9.7c0 3.7-3.4 6.9-8.45 10.64-.15.11-.35.16-.55.16Z"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"
            />
          </svg>
        </span>
        <span class="floating-like__count" data-like-count-value aria-live="polite" aria-atomic="true">0</span>
      </button>
      <span class="floating-like__status" id={`like-status-${slug}`} data-like-hint aria-live="polite" />
    </aside>
  )
}

<script>
  import { initLikeButtons } from "../utils/likeButton.client";

  document.addEventListener("astro:page-load", () => {
    void initLikeButtons();
  });
</script>
