    "astro": "^7.2.4",
    "motion": "^12.40.0",
    "open-props": "^1.7.23",
    "sass": "^1.100.0",
    "satori": "^0.29.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^5.9.3"
  }
