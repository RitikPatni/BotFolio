{
  "name": "botfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:cf": "npm run standard-site:generate && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "a11y:routes": "node scripts/a11y-route-check.mjs --ci",
    "routes:ci": "node scripts/route-contracts.mjs",
    "qa:site": "npm run check && npm run build && npm run a11y:routes && npm run routes:ci",
    "content:frontmatter:parity": "node scripts/content-frontmatter-parity.mjs",
    "content:frontmatter:fix": "node scripts/content-frontmatter-parity.mjs --write",
    "content:frontmatter:ci": "node scripts/content-frontmatter-parity.mjs --ci",
    "books:covers:parity": "node scripts/goodreads-cover-parity.mjs",
    "books:covers:fix": "node scripts/goodreads-cover-parity.mjs --write",
    "books:covers:ci": "node scripts/goodreads-cover-parity.mjs --ci",
    "books:metadata:enrich": "node scripts/enrich-book-frontmatter-openlibrary.mjs",
    "books:metadata:fix": "node scripts/enrich-book-frontmatter-openlibrary.mjs --write",
    "books:metadata:ci": "node scripts/enrich-book-frontmatter-openlibrary.mjs --ci",
    "gallery:validate": "node scripts/validate-gallery.mjs",
    "images:optimize": "bash scripts/optimize-images.sh",
    "gallery:validate:strict": "node scripts/validate-gallery.mjs --strict",
    "gallery:validate:ci": "node scripts/validate-gallery.mjs --ci",
    "gallery:hook:install": "node scripts/install-gallery-hook.mjs",
